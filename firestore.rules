rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.matches('.*admin.*') ||
         request.auth.token.email == 'vikasgupta22986@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Students collection: profiles and biometric face embedding
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Subjects collection (courses catalog)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance collection (smart kiosk logs & records)
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Timetable collection (lecture schedules)
    match /timetable/{scheduleId} {
      allow read: if true;
      allow write: if true;
    }

    // Marks collection (internal assessments and grading)
    match /marks/{markId} {
      allow read: if true;
      allow write: if true;
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if true;
      
      match /submissions/{submissionId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Top-level submissions collection
    match /submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Exams collection (examination schedules)
    match /exams/{examId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications collection (notices & announcements)
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles & settings
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Health check & connection validation
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
